HOST=127.0.0.1
PORT=8080
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
CHAOS_TICK_INTERVAL=1s
CHAOS_MAX_ACTIVE=10

# Slack is optional. Leave both tokens empty to run without it.
# Set both to switch it on: the app token starts with xapp- and the bot token with xoxb-.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Comma separated Slack user IDs to invite into every incident channel, for example U012ABC,U045DEF.
SLACK_INVITE_USER_IDS=
# Channel ID where new incidents are announced, for example C012ABC.
SLACK_ANNOUNCE_CHANNEL_ID=

# Postgres is optional. Leave this empty to keep everything in memory.
# Use the pooled connection string from Neon or Supabase, for example
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Protection for a public demo.
# When ADMIN_TOKEN is set, injecting and halting need the header "Authorization: Bearer <token>".
# It must be at least 32 characters long. Make one with: openssl rand -hex 32
# Leave it empty to keep them open to everyone, which is still rate limited.
ADMIN_TOKEN=
# Each caller may inject or halt RATE_LIMIT_BURST times in a row, and earns one more turn every RATE_LIMIT_REFILL.
RATE_LIMIT_BURST=5
RATE_LIMIT_REFILL=30s
# Websites that may call the API from a browser, comma separated. The local frontend runs on port 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public demo mode. When true, visitors may start drills without the admin token.
# Those drills are marked public, have their own limit, and never post to Slack.
# A visitor can only halt public drills. Drills started with the admin token work as always.
PUBLIC_DRILLS=false
# How many public drills may run at once. It must be smaller than CHAOS_MAX_ACTIVE.
PUBLIC_MAX_ACTIVE=5

# How many live metric streams may be open at once, for everyone together and for one IP address.
STREAM_MAX_TOTAL=100
STREAM_MAX_PER_IP=5

# How many proxies in front of the server may be trusted to report the caller's address.
# Keep 0 when you run the server directly. Use 1 on Render.
TRUSTED_PROXY_HOPS=0

# APP_ENV=production makes the server refuse a DATABASE_URL without sslmode=require (or stricter)
# and send the Strict-Transport-Security header.
